# ================================================
# Database Kopi - Environment DEV (terpisah dari prod)
# Copy:  cp .env.dev.example .env.dev
# Pakai: docker compose --env-file .env.dev -f docker-compose.dev.yaml up
# ================================================
# Nama DB & volume sengaja beda dari prod agar data dev tidak bercampur.

# --- PostgreSQL (dev) ---
POSTGRES_DB=kopi_db_dev
POSTGRES_USER=kopi_dev
POSTGRES_PASSWORD="dev-password"
POSTGRES_PORT=5545

# --- BE (dev) ---
BE_PORT=8091
JWT_SECRET="dev-only-secret-change-me-32-bytes-minimum"
ADMIN_USERNAME=caritas
ADMIN_PASSWORD="dev-admin-password"
STORAGE_PATH=/app/data/uploads
APP_URL="http://localhost:8091"
