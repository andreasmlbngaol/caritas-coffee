# ================================================
# Database Kopi (Caritas Kopi) - Environment
# Copy:  cp .env.example .env
# Lalu isi nilai asli untuk lingkunganmu.
# ================================================

# --- PostgreSQL ---
# Dipakai service `db` dan service `be` (di dalam network compose host = `db`).
POSTGRES_DB=kopi_db
POSTGRES_USER=kopi
POSTGRES_PASSWORD="change-this-to-a-strong-password"
# Port yang diekspos ke host (opsional, untuk akses psql dari VPS).
POSTGRES_PORT=5544

# --- BE (Spring Boot) ---
# Port BE di host (opsional, biasanya hanya diakses lewat nginx FE).
BE_PORT=8089

# --- Auth ---
# Rahasia penanda tangan JWT. Generate:  openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32"

# --- Admin seeding ---
# Kredensial admin awal, dibuat otomatis saat BE pertama kali start.
ADMIN_USERNAME=caritas
ADMIN_PASSWORD="change-this-to-a-strong-password"

# --- Storage foto (lokal, di volume Docker) ---
# Path di dalam container BE tempat foto disimpan (dipetakan ke volume `uploads`).
STORAGE_PATH=/app/data/uploads

# --- App ---
# URL publik aplikasi (dipakai untuk link foto di dalam ekspor PDF/DOCX).
# Di produksi ini URL FE (nginx), bukan BE, karena nginx yang mem-proxy /api.
APP_URL="http://localhost:8088"

# --- FE (nginx) ---
# Port publik aplikasi di host.
FE_PORT=8088
